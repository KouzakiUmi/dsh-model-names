{
  "name": "dsh-model-names",
  "displayName": "Provider / 模型显示名",
  "version": "0.2.0",
  "description": "内置 provider / 模型显示名的全量数据库：载入时按环境里实际启用的 provider 与模型覆盖显示名，只影响 UI，不改路由、请求与凭据。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "data/model-names.json",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "llm",
    "display-name"
  ],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KouzakiUmi/dsh-model-names.git"
  },
  "homepage": "https://github.com/KouzakiUmi/dsh-model-names#readme",
  "bugs": {
    "url": "https://github.com/KouzakiUmi/dsh-model-names/issues"
  }
}
